# Cópia este arquivo para .env e preencha com seus valores reais
# Nunca versione o .env com credenciais reais

# ===== BANCO DE DADOS =====
# Conexão com PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reviewdatabase
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

# URL completa (alternativa)
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/reviewdatabase

# ===== SERVIDOR =====
PORT=3001
NODE_ENV=development
